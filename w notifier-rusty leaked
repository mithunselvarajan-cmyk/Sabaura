		for i, d in ipairs(rows) do d.order = i
			if not activeRows[d.uid] then local f, a, fl, vs, jb, gl, sl, tk, gw, fg = buildRow(d); f.Parent = list
				activeRows[d.uid] = { frame = f, age = a, fill = fl, vsub = vs, join = jb, genLbl = gl, subLbl = sl, tick = tk, glow = gw, fillGrad = fg, startTime = d.time or os.clock(), data = d }
				seenCount = seenCount + 1; _pendingHits = _pendingHits + 1
				if not _suppressSound then playLogSound() end
			else
				local e = activeRows[d.uid]; e.frame.LayoutOrder = i; e.data = d
				e.data.genNum = d.money or parseGen(d.gen)          -- ★ refresh genNum (đừng giữ giá trị cũ)
				local ncol = rc(d.rarity)
				if e.genLbl then e.genLbl.Text = d.gen or "--" end                                   -- ★ refresh headline $/s
				if e.subLbl then e.subLbl.Text = d.tierLabel or string.upper(d.rarity or "Normal"); e.subLbl.TextColor3 = ncol end  -- ★ refresh tier/màu
				if e.tick then e.tick.BackgroundColor3 = ncol end
				if e.glow then e.glow.Visible = RARE_GLOW[d.rarity] == true; e.glow.ImageColor3 = ncol end   -- ★ glow theo tier mới (đổi MID↔OG…)
				if e.fill then e.fill.BackgroundColor3 = ncol end
				if e.fillGrad then e.fillGrad.Color = ColorSequence.new(ncol:Lerp(Color3.new(0,0,0), 0.45), ncol) end   -- ★ màu thanh rarity theo tier mới
			end
		end
		local n = 0; for _ in pairs(activeRows) do n = n + 1 end
		statActive.Text = tostring(n); statSeen.Text = tostring(seenCount)
		if n > _lastActive and not _suppressSound then
			statActive.TextSize = 24
