    -- ── SEND (dedup + disk-pending) ──
    local function robloxName() return "@" .. (LP.DisplayName or LP.Name) end
    -- ★ GỬI steal-report qua wnotifier API (THAY webhook Discord trực tiếp). Body {brainrot, worth} + header X-Track-Token (operator token).
    --   Server tự build embed + thumbnail (theo tên) + pacing/batch + KHÔNG dedup → dedup/cache client-side GIỮ NGUYÊN. Reliable: retry mạng + 429 backoff.
    local STEAL_URL = "https://api.wnotifier.com/api/v1/steal-report"
    local STEAL_ENABLED = false   -- ★★ TẠM TẮT steal-report (user: chưa ổn). Đổi = true để BẬT lại gửi. Detection/cache vẫn chạy nền.
    local function stealBody(name, worth)
        return Http:JSONEncode({ brainrot = tostring(name or ""), worth = (worth ~= nil and worth ~= "") and tostring(worth) or nil })
    end
    local function postStealReport(name, worth)   -- reliable POST → API; trả true khi 2xx (forward queued/skipped đều = thành công)
        if not STEAL_ENABLED then return false end   -- ★ tạm tắt → KHÔNG POST gì
        local f = (syn and syn.request) or request or http_request or (http and http.request)
        if not f or not name or tostring(name) == "" then return false end
        local body = stealBody(name, worth)
        local hdr  = { ["Content-Type"] = "application/json", ["X-Track-Token"] = CONFIG.TrackToken }   -- ★ token = CONFIG.TrackToken (d491ec24...) — TEST LIVE: getgenv().Key→404, TrackToken→200 forward:queued
        local deadline, attempt = clk() + 20, 0
        repeat
            attempt = attempt + 1
            local ok, r = pcall(f, { Url = STEAL_URL, Method = "POST", Headers = hdr, Body = body })
            if not ok then task.wait(0.8)
            else
                local code = tonumber(r and (r.StatusCode or r.Status or r.status_code))
                if (code and code >= 200 and code < 300) or (not code) then return true end            -- 2xx = success (queued/skipped)
                if code == 429 then task.wait(2.5)                                                      -- 120/min per-IP → backoff
                elseif code and code >= 400 and code < 500 then                                         -- 400 (thiếu brainrot/JSON hỏng) / 404 (SAI token / sai path) → ko retry
                    LOG(("[steal] API HTTP %d (ko retry — check X-Track-Token?): %s"):format(code, tostring(r and r.Body):sub(1, 120))); return false
                else task.wait(0.8) end                                                                 -- 5xx / lạ → retry
            end
        until clk() >= deadline or attempt >= 30
        return false
    end
    local function sendEmbed(name, worth, mutation, img)   -- giữ signature cũ; contract mới CHỈ dùng name+worth (mutation/thumbnail server tự lo theo tên)
        return postStealReport(name, worth)
    end
    local function savePending(d)
        pcall(function() if writefile then writefile(PEND_FILE, Http:JSONEncode({ name = d.name, worth = d.worth, mutation = d.mutation, uuid = d.uuid, ts = epoch() })) end end)
    end
    -- ★ XOÁ TIN CẬY: nhiều executor KHÔNG có delfile → trước đây file pending ko bao giờ xoá → game.Close + rejoin gửi lại = DUPE 2-3 lần.
    --   Giờ BLANK bằng writefile("") (luôn có) → loadPending JSONDecode "" fail → coi như rỗng. delfile chỉ là dọn thêm nếu có.
    local function clearPending()
        pcall(function() if writefile then writefile(PEND_FILE, "") end end)
        pcall(function() if delfile and isfile and isfile(PEND_FILE) then delfile(PEND_FILE) end end)
    end
    local function loadPending()
        local ok, d = pcall(function() if isfile and isfile(PEND_FILE) then return Http:JSONDecode(readfile(PEND_FILE)) end end)
        if not (ok and type(d) == "table" and type(d.name) == "string") then return nil end
        if d.ts and (epoch() - tonumber(d.ts)) > 120 then return nil end          -- ★ pending quá CŨ (>2p) → bỏ (chống re-send dai dẳng nếu clear vẫn lỗi); steal mới luôn <2p
        return d
    end
    -- ★★ SENT-LOG PERSIST (chống dupe QUA HOP server — thủ phạm chính): đánh dấu con ĐÃ gửi lên ĐĨA → hop sang server mới
    --   đọc lại thấy "đã gửi" → KHÔNG gửi lại. key = uuid + name|worth|mutation (1 con ko tự re-steal trong 5p; steal khác = uuid/worth khác).
    --   Đánh dấu NGAY trước khi gửi + ghi đĩa ĐỒNG BỘ → kể cả bị kick tức thì, server sau vẫn thấy. TTL 5p tự prune.
    local SENT_FILE = "WN_steal_sent_" .. USERID .. ".json"
    local SENT_TTL_UUID = 6 * 3600   -- ★ con ĐÃ POST → cache UUID 6 TIẾNG → KO post lại (siêu chắc ăn, dedup qua MỌI hop/rejoin trong 6h)
    local SENT_TTL_NAME = 300         -- key name|worth|mut: 5p (fallback khi steal ko có UUID + gộp M1/M2 qua hop). NGẮN để con KHÁC cùng tên/worth vẫn post (giữ "nhiều detect").
    local function _sentTTL(k) return (tostring(k):sub(1, 2) == "u:") and SENT_TTL_UUID or SENT_TTL_NAME end   -- key "u:"=UUID→6h, "k:"=name→5p
    local _sentLog  = {}
    local function _sentKeys(d)
        -- ★ CÓ uuid → CHỈ dedup theo u:uuid (uuid ổn định + DUY NHẤT mỗi con) → 2 con KHÁC uuid dù cùng name/worth/mut VẪN gửi cả 2
        --   (vd cướp 2 con Rồng). KHÔNG kèm k:name|worth|mut nữa vì key đó gộp nhầm 2 con giống hệt = nuốt mất con thứ 2.
        if d.uuid and d.uuid ~= "" then return { "u:" .. tostring(d.uuid) } end
        return { "k:" .. tostring(d.name) .. "|" .. tostring(d.worth) .. "|" .. tostring(d.mutation) }   -- KO uuid (M2 fallback) → k-key 5p
    end
    local function sentLogPrune()
        local t = epoch()
        for k, ts in pairs(_sentLog) do if (t - (tonumber(ts) or 0)) > _sentTTL(k) then _sentLog[k] = nil end end
    end
    local function sentLogLoad()
        pcall(function() if isfile and isfile(SENT_FILE) then local x = Http:JSONDecode(readfile(SENT_FILE)); if type(x) == "table" then _sentLog = x end end end)
        sentLogPrune()
    end
    local function alreadySent(d)
        local t = epoch()
        for _, k in ipairs(_sentKeys(d)) do local ts = _sentLog[k]; if ts and (t - tonumber(ts)) < _sentTTL(k) then return true end end
        return false
    end
    local function markSent(d)
        local t = epoch()
        for _, k in ipairs(_sentKeys(d)) do _sentLog[k] = t end
        sentLogPrune()
        pcall(function() if writefile then writefile(SENT_FILE, Http:JSONEncode(_sentLog)) end end)   -- PERSIST NGAY (đồng bộ) → server sau thấy liền
    end
    -- ★ game.Close FLUSH (best-effort): đóng game → POST ĐỒNG BỘ pending còn sót TRƯỚC khi process chết.
    --   Chỉ xoá pending khi nhận 2xx (gửi land chắc) → fail/chết giữa chừng thì GIỮ → rejoin gửi lại (ko mất, ko trùng).
    local function flushPendingNow()
        if not STEAL_ENABLED then return end                            -- ★ TẠM TẮT steal-report → ko flush lúc game.Close
        local p = loadPending(); if not p then return end
        if alreadySent(p) then pcall(clearPending); return end          -- ★ đã gửi (live/server trước) → bỏ, chống dupe game.Close
        markSent(p)                                                     -- ★ đánh dấu TRƯỚC khi gửi
        local f = (syn and syn.request) or request or http_request or (http and http.request)
        if not f then return end
        local ok, r = pcall(f, { Url = STEAL_URL, Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["X-Track-Token"] = CONFIG.TrackToken },   -- ★ token = CONFIG.TrackToken (test live 200)
            Body = stealBody(p.name, p.worth) })
        local code = ok and r and (r.StatusCode or r.status)
        if (code and code >= 200 and code < 300) or (ok and code == nil) then pcall(clearPending) end
    end
    local _sent = {}
    local function reportSteal(d, src)
        if not STEAL_ENABLED then return end                                      -- ★ TẠM TẮT steal-report → ko markSent/pending/gửi (detection vẫn chạy nền)
        if not isCurrentGen() then return end                                     -- ★ OLD exec (đã re-run) → KHÔNG gửi → chống double webhook (thay cho jobId genlock cũ)
        local name = d.name or "Unknown"
        if alreadySent(d) then return end                                         -- ★★ ĐÃ gửi (phiên này HOẶC server trước qua hop) → BỎ. Đây là chốt chống dupe-qua-hop.
        -- ★ name-collapse (6s) CHỈ khi KHÔNG có uuid (M2 fallback bare) → chặn dúp no-uuid.
        --   CÓ uuid thì u:uuid (6h) đã lo → 2 con KHÁC uuid vẫn gửi cả 2 (fix "nuốt con thứ 2"); M1+M2 cùng uuid → alreadySent gộp.
        if not (d.uuid and d.uuid ~= "") then
            local t = clk()
            local nmk = "nm:" .. tostring(name)
            if (_sent[nmk] or 0) + (SD.NAME_DEDUP_SEC or 6) > t then return end
            _sent[nmk] = t
        end
        markSent(d)                                                               -- ★★ ĐÁNH DẤU + ghi đĩa ĐỒNG BỘ NGAY (trước khi gửi) → bị kick liền thì server sau vẫn thấy "đã gửi"
        savePending(d)
        task.spawn(function()
            local ok = sendEmbed(name, d.worth, d.mutation, getImg(name))         -- gửi NGAY (ảnh nếu cache sẵn) — module postJson tự retry/429 tới khi land
            if not getImg(name) then startImg(name) end                           -- fetch ảnh cho lần sau (ko chặn lần này)
            if ok then clearPending() end
        end)
    end

    -- ── resolve data cho Method 2 (ưu tiên: live plot mình -> cache theo index -> bare) ──
    local _prevUUID = {}          -- [plotName] = {uuid=true} snapshot
    local function resolveByIndex(val)
        local index = indexFromAny(val) or tostring(val)
        local disp  = dispName(index)
        local myName, myCh = getMyPlot()
        if myCh then
            local list = animalList(myCh)
            if type(list) == "table" then
                local best
                for _, item in pairs(list) do
                    if type(item) == "table" and tostring(item.Index) == tostring(index) then
                        local prev  = _prevUUID[myName]
                        local fresh = item.UUID and not (prev and prev[tostring(item.UUID)])
                        if fresh then best = item; break end
                        best = best or item
                    end
                end
                if best then local w = worthOf(best); return { name = disp, worth = w, mutation = mutOf(best), uuid = best.UUID and tostring(best.UUID) } end
            end
        end
        local bestC, bestU
        for uuid, e in pairs(cache) do
            if type(e) == "table" and tostring(e.index) == tostring(index) then
                if not bestC or (tonumber(e.ts) or 0) > (tonumber(bestC.ts) or 0) then bestC = e; bestU = uuid end
            end
        end
        if bestC then return { name = disp, worth = bestC.worth, mutation = bestC.mutation, uuid = bestU } end
        local w = worthOf({ Index = index })
        return { name = disp, worth = w, mutation = nil }
    end

    -- ── METHOD 1: watch MỌI plot (re-cache) + plot MÌNH (detect cướp) ──
    local function handlePlotChange(plotName)
        local ch = chOf(plotName); if not ch then return end
        local list, owner = animalList(ch)
        if type(list) ~= "table" then return end
        local mine = isMyChannel(ch, owner)
        local curr = {}
        if mine then
            -- detect TRƯỚC khi re-cache: UUID MỚI trên plot mình mà TỪNG thấy thuộc người khác => MÌNH vừa cướp ("gặp 2 lần").
            --   2 nguồn bằng chứng sở hữu (OR): (a) main cache owner≠mình (thấy gần đây); (b) foreignOwner 6h (thấy lần 1, kể cả VIP/qua server).
            local prev = _prevUUID[plotName]
            for _, item in pairs(list) do
                if type(item) == "table" and item.Index and item.UUID then
                    local uuid = tostring(item.UUID)
                    curr[uuid] = true
                    if not (prev and prev[uuid]) then
                        local c = cache[uuid]
                        local byCache   = c and c.owner and c.owner ~= "" and not meName(c.owner)
                        local byForeign = fownSeen(uuid)
                        if byCache or byForeign then
                            local w = worthOf(item)
                            reportSteal({ name = dispName(item.Index), worth = w, mutation = mutOf(item), uuid = uuid }, byForeign and "seen2x" or "sync")
                            foreignOwner[uuid] = nil                                       -- ★ giờ là của mình → bỏ khỏi foreign (sent-log 6h vẫn chặn repost)
                        end
                    end
                end
            end
        else
            -- plot NGƯỜI KHÁC → nhớ sở hữu (nguồn cho "gặp 2 lần" sau này)
            local foreign = owner and owner ~= "" and not meName(owner)
            for _, item in pairs(list) do
                if type(item) == "table" and item.UUID then
                    curr[tostring(item.UUID)] = true
                    if foreign then fownMark(item.UUID) end
                end
            end
        end
        -- re-cache plot (gán owner hiện tại — plot mình => mình)
        local own = mine and LP.Name or owner
        for _, item in pairs(list) do
            if type(item) == "table" and item.Index then cachePut(item, own) end
        end
        _prevUUID[plotName] = curr
        cacheSave(false); fownSaveF(false)
    end
    local _hooked = setmetatable({}, { __mode = "k" })
