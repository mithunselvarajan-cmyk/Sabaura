-- ★ WHITELIST per-brainrot (KaWaifu-style) — 2 cái RIÊNG: WL_SV (lọc hiển thị Servers) + WL_AJ (auto-join).
--   entries[lower(brainrotName)] = { mut = "Any"|"<Mutation>", min = <$/s>, state = "none"|"whitelist"|"blacklist" }
--   state: blacklist = ẨN hẳn; whitelist = (nếu có bất kỳ con whitelist → CHỈ hiện con whitelist khớp); none = mặc định.
--   noneFilter(bool)+noneMin(number): con state="none" — khi noneFilter ON phải gen ≥ noneMin mới qua. hasWL = có con whitelist.
local WL_SV = { entries = {}, noneFilter = false, noneMin = 0, hasWL = false }
local WL_AJ = { entries = {}, noneFilter = false, noneMin = 0, hasWL = false }
local function wlRecount(wl)   -- gọi sau khi đổi state → cập nhật hasWL (có đang ở chế độ whitelist không)
    wl.hasWL = false
    for _, e in pairs(wl.entries) do if e.state == "whitelist" then wl.hasWL = true; break end end
end
-- tách chuỗi best "[Mut] Name" → name, mutation ("" nếu ko có)
local function parseBest(best)
    best = tostring(best or "")
    local m, n = best:match("^%[([^%]]+)%]%s*(.+)$")
    if n then return n, m end
    return best, ""
end
-- con (name, mut, gen) có QUA whitelist `wl` không?
--   ★ NGỮ NGHĨA (theo yêu cầu sếp): CHỈ "blacklist" mới chặn. "none" = coi như "whitelist" (CHO QUA, không chặn).
--   → KHÔNG còn chế độ "chỉ-whitelist" (set 1 con whitelist KHÔNG chặn các con khác nữa) — khách dùng filter tier/name cũ
--   vẫn auto-join bình thường. none + whitelist đều qua; nếu entry có đặt mut/min thì áp (lọc tinh con đó).
local function wlPass(wl, name, mut, gen)
    local e = wl.entries[tostring(name):lower()]
    local state = (e and e.state) or "none"
    if state == "blacklist" then return false end                       -- ★ CHỈ blacklist mới chặn (ẩn / không join)
    if e then                                                           -- none/whitelist: cho qua, nhưng áp mut/min nếu đã đặt
        if e.mut and e.mut ~= "Any" and tostring(e.mut):lower() ~= tostring(mut):lower() then return false end
        if (tonumber(gen) or 0) < (tonumber(e.min) or 0) then return false end
    end
    if wl.noneFilter and (tonumber(gen) or 0) < (tonumber(wl.noneMin) or 0) then return false end   -- None State Filter (tuỳ chọn)
    return true
end

-- matchSets: server matches multi-select criteria (tier-set / name-set) — OR. both sets empty → treated as matching all.
local function matchSets(s, tiers, names)
    local hasTiers, hasNames = next(tiers) ~= nil, next(names) ~= nil
    if not hasTiers and not hasNames then return true end
    if hasTiers and tiers[tostring(s.tier):upper()] then return true end
    if hasNames then
        local b = tostring(s.best):lower()
        for nm in pairs(names) do if b:find(nm:lower(), 1, true) then return true end end
    end
    return false
end
-- passesFilter: LIST shown in Servers tab — money threshold AND (tier-set/name-set, OR).
local function passesFilter(s)
    if not vipTierAllowed(s.tier) then return false end   -- ★ VIP GATING: gói user chỉ render tier được phép (⚠️ bypass được — xem _vipText)
    if CONFIG.HideFusing ~= false and tostring(s.status or ""):lower() == "fusing" then return false end   -- ★ filter: hide FUSING (locked, not stealable)
    if (tonumber(s.money) or 0) < (SV_MIN[VIEW.moneyKey] or 0) then return false end
    local nm, mt = parseBest(s.best)
    if not wlPass(WL_SV, nm, mt, s.money) then return false end   -- ★ chỉ blacklist mới ẩn; none/whitelist cho qua → vẫn lọc theo tier/name cũ
    return matchSets(s, VIEW.tiers, VIEW.names)
end
-- autoMatches: AUTO-JOIN multi-select — tier ∈ AUTO.tiers OR name matches AUTO.names (and ≥ $/s min).
--   DIFFERS from passesFilter: both sets empty → DO NOT auto-join (avoid jumping around randomly before criteria are chosen).
local function autoMatches(s)
    if not (s and type(s.jobId) == "string" and s.jobId ~= "") then return false end
    if s.jobId:sub(1, 14) == "wnotifier.com-" then return false end           -- not yet decrypted (wrong key)
    if s.jobId == game.JobId then return false end                            -- ★ đừng auto-join chính server đang ở (vô nghĩa, chỉ reload)
    if not vipTierAllowed(s.tier) then return false end                       -- ★ VIP GATING: ko auto-join tier ngoài gói (⚠️ bypass được)
    if CONFIG.HideFusing ~= false and tostring(s.status or ""):lower() == "fusing" then return false end   -- ★ never auto-join FUSING (not stealable)
    if (tonumber(s.money) or 0) < (AUTO.moneyMin or 0) then return false end
    local nm, mt = parseBest(s.best)
    -- ★ MODE = "whitelist": pet ĐÃ THÊM vào list (state none HOẶC whitelist, áp mut/min nếu đặt) → auto-join. CHỈ blacklist + pet NGOÀI list bị bỏ.
    --   ("thêm pet = join" — khỏi phải bấm cycle state thành 'whitelist'; default 'none' của entry vẫn join). Filter tier/name KHÔNG dùng ở mode này.
    if AUTO.mode == "whitelist" then
        local e = WL_AJ.entries[tostring(nm):lower()]
        if not e or e.state == "blacklist" then return false end   -- ★ chỉ pet ĐÃ THÊM & ko blacklist (none|whitelist đều join)
        if e.mut and e.mut ~= "Any" and tostring(e.mut):lower() ~= tostring(mt):lower() then return false end
        if (tonumber(s.money) or 0) < (tonumber(e.min) or 0) then return false end
        return true
    end
    -- ★ MODE = "filter" (mặc định): blacklist BỎ; none/whitelist cho qua; chọn theo tier/name cũ
    if not wlPass(WL_AJ, nm, mt, s.money) then return false end
    if not (next(AUTO.tiers) or next(AUTO.names)) then return false end        -- chưa chọn tier/name → KHÔNG auto-join (tránh nhảy lung tung)
    return matchSets(s, AUTO.tiers, AUTO.names)
end
-- ★ jobId vừa thử force xong (chưa hết AutoRetrySameSec) → tạm bỏ qua để driver xoay sang con khác (tránh kẹt 1 server full)
local function jobOnCooldown(jid)
    local t = jid and _jobTried[jid]
    return t ~= nil and (os.clock() - t < (CONFIG.AutoRetrySameSec or 25))
end
-- ★ chọn server nào trong các server KHỚP: "best" = tier cao nhất → rồi $/s; "newest" = server VỪA tới (seen lớn nhất)
local function pickBetter(s, cur)
    if not cur then return true end
    if AUTO.pick == "newest" then return (s.seen or 0) > (cur.seen or 0) end
    local rs, rb = tierRankOf(s.tier), tierRankOf(cur.tier)
    if rs ~= rb then return rs > rb end
    return (tonumber(s.money) or 0) > (tonumber(cur.money) or 0)
end
local function tryAutoJoin(s)
    if not AUTO.on then return end
    if not autoMatches(s) then return end
    if jobOnCooldown(s.jobId) then return end   -- ★ vừa thử server này (full→fail) → xoay con khác trước
    if isForcing() then
        -- ★ đang AUTO-force server cũ mà có server TỐT HƠN tới → NHẢY qua. "TỐT HƠN" theo đúng mode:
        --   newest = seen mới hơn · highest = tier (rồi $/s) cao hơn — cùng dùng pickBetter(s, _autoTarget).
        --   CHỈ khi force hiện tại là của auto-join (curJob == _autoTarget.jobId) + ≥AutoJoinCooldown (đã force ≥2s = server cũ đang fail; tránh nhảy loạn / ko đụng FORCE tay).
        local _, _, curJob = forceProgress()
        -- ★ ForcePreemptNew (bất chấp): server MỚI NÀO khớp filter (khác server đang force) → NHẢY NGAY, ko cần "tốt hơn"/cooldown.
        local switchNew = CONFIG.ForcePreemptNew == true and s.jobId ~= curJob
        -- (cũ) chỉ nhảy khi force hiện tại là của auto-join + server mới TỐT HƠN + đã qua AutoJoinCooldown
        local switchBetter = _autoTarget and curJob == _autoTarget.jobId and s.jobId ~= curJob
            and pickBetter(s, _autoTarget) and (os.clock() - _autoJoinedAt) >= (CONFIG.AutoJoinCooldown or 2)
        if switchNew or switchBetter then
            _joinActive = false; _autoTarget = s   -- ★ dừng force cũ IM LẶNG (gen token lo vòng cũ thoát sạch); joinServer mới bật lại
            _autoJoinedAt = os.clock(); _jobTried[s.jobId] = os.clock()
            notify(CONFIG.ServiceName or "W Notifier", "Auto-join switch → " .. tostring(s.best), 3)
            LOG("[AUTO-JOIN] switch" .. (switchNew and " NEW(preempt)" or "") .. " →", s.best, s.tier, s.jobId)
            joinServer(game.PlaceId, s.jobId, CONFIG.ForceAttempts or 15)
        end
        return
    end
    if os.clock() - _autoLoadTick < (CONFIG.AutoJoinStartDelay or 5) then return end   -- grace after load (fallback khớp config/driver = 5)
    if os.clock() - _autoJoinedAt < (CONFIG.AutoJoinCooldown or 2) then return end       -- cooldown
    _autoTarget = s
    _autoJoinedAt = os.clock(); _jobTried[s.jobId] = os.clock()
    notify(CONFIG.ServiceName or "W Notifier", "Auto-join → " .. tostring(s.best), 3)
    LOG("[AUTO-JOIN]", s.best, "$" .. tostring(s.money), s.tier, s.jobId)
    joinServer(game.PlaceId, s.jobId, CONFIG.ForceAttempts or 15)   -- ★ SPAM vào target (vào server full mượt như force)
end
-- scan the WHOLE list NOW, join the BEST/NEWEST server matching the criteria (called on toggle/selection-change + driver mỗi giây).
local function autoJoinScanNow()
    if not AUTO.on then return end
    if isForcing() then return end   -- ★ đang spam-join rồi → bỏ (switch-newest do tryAutoJoin lo)
    if os.clock() - _autoJoinedAt < (CONFIG.AutoJoinCooldown or 2) then return end
    local best
    for _, s in pairs(wsServers) do
        if autoMatches(s) and not jobOnCooldown(s.jobId) and pickBetter(s, best) then best = s end
    end
    if best then
        _autoTarget = best
        _autoJoinedAt = os.clock(); _jobTried[best.jobId] = os.clock()
        notify(CONFIG.ServiceName or "W Notifier", "Auto-join → " .. tostring(best.best), 3)
        LOG("[AUTO-JOIN scan]", best.best, "$" .. tostring(best.money), best.tier, best.jobId)
        joinServer(game.PlaceId, best.jobId, CONFIG.ForceAttempts or 15)   -- ★ SPAM vào target
    end
end

local function upsertServer(name, data)
    if type(data) ~= "table" then WSDBG.dropNotTable = (WSDBG.dropNotTable or 0) + 1; return end   -- ★ handle truyền STRING thô (JSON decode fail) → đếm thay vì biến mất câm
    WSDBG.recv = WSDBG.recv + 1   -- ★ 1 find tới được upsert (đã decode JSON ok)
    local jid = data.jobId
    if type(jid) ~= "string" or jid == "" then WSDBG.dropNoJob = WSDBG.dropNoJob + 1; return end
    if jid:sub(1, 14) == "wnotifier.com-" then WSDBG.dropDecrypt = WSDBG.dropDecrypt + 1; return end   -- ★ jobId KHÔNG giải được (sai key/cipher / ClientSab cũ) → BỎ (đếm để soi)
    -- ★ SEC: jobId PHẢI đúng dạng UUID 36 ký tự (dấu '-' ở 9/14/19/24) — chống relay nhồi jobId rác / ép join server tuỳ ý.
    if not (#jid == 36 and jid:byte(9) == 45 and jid:byte(14) == 45 and jid:byte(19) == 45 and jid:byte(24) == 45) then
        WSDBG.dropUuid = (WSDBG.dropUuid or 0) + 1
        if (WSDBG.dropUuid % 20) == 1 then WARN(("[cdev] DROP bad-UUID #%d jid=%q (len %d) — decode méo / reserved-code?"):format(WSDBG.dropUuid, tostring(jid):sub(1, 40), #jid)) end
        return
    end
    -- ★ VIP GATING TỪ GỐC: tier ngoài gói → KHÔNG nạp vào wsServers (count KHÔNG nhảy, render/auto-join ko thấy).
    --   ⚠️ vẫn BYPASS được (relay gửi-hết → data tới onMsg/handle TRƯỚC upsertServer; hook onMsg / chain __CDEV_OnData vén
    --   được). Đây là chặn-từ-gốc cho CHUẨN LOGIC phía honest user; lớp chặn thật vẫn phải ở RELAY.
    if not vipTierAllowed(data.tier) then
        WSDBG.dropVip = (WSDBG.dropVip or 0) + 1
        if (WSDBG.dropVip % 20) == 1 then WARN(("[cdev] DROP vip-gate #%d (tier=%q ngoài gói, _vipText=%s) — nếu MỌI find drop ở đây → VipText/tier-schema sai"):format(WSDBG.dropVip, tostring(data.tier), tostring(_vipText))) end
        return
    end
    local best = tostring(data.best or "?")
    local key = jid .. "|" .. best                       -- ★ jobId + brainrot name
    local rec = {
        jobId = jid, channel = tostring(name or "?"),
        best = best, money = tonumber(data.money) or 0,
        tier = tostring(data.tier or ""),   -- ★ tier field from sab_scanner (OG/PEAK/HIGH/MID/LOW) — Servers tab filter
        status = tostring(data.status or "?"), time = data.time, seen = os.time(),
    }
    -- ★ only REBUILD when structure changes (new row / money / tier / status / best) — heartbeat only refreshing `seen`,
    --   tickServers updates the countdown IN PLACE (reads rec.seen live), DOES NOT rebuild the whole list each second (avoids destroy/sort).
    local old = wsServers[key]
    if (not old) or old.money ~= rec.money or old.tier ~= rec.tier or old.status ~= rec.status or old.best ~= rec.best then
        serversDirty = true
        if feedSoon then feedSoon() end   -- ★ render NGAY (reactive) — ko chờ tick MAIN LOOP, cắt ~250ms trễ hiển thị
    end
    wsServers[key] = rec
    tryAutoJoin(rec)   -- ★ auto-join right when a server matching the filter arrives (realtime snipe)
end

