local function ownerFromSign(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return nil end
    for _, d in ipairs(sign:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" then
            local t = d.Text
            if t ~= "YOUR BASE" and d.Parent.Name ~= "YourBase" and t ~= "Empty Base" then
                local n = t:match("^(.-)'s Base$")
                if n and n ~= "" then return n end
            end
        end
    end
    return nil
end
local function findMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local owner = ownerFromSign(plot)
        if owner == REAL_NAME or owner == REAL_DISPLAY then return plot end   -- ★ REAL name (DisplayName already masked → don't use LocalPlayer.DisplayName)
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local closest, best = nil, math.huge
        for _, plot in ipairs(plots:GetChildren()) do
            local spawn = plot:FindFirstChild("Spawn")
            if spawn and spawn:IsA("BasePart") then
                local d = (hrp.Position - spawn.Position).Magnitude
                if d < best then best = d; closest = plot end
            end
        end
        return closest
    end
    return nil
end



