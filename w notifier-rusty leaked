                _onlineRetries = _onlineRetries + 1
                setStatus(("Reconnecting (busy session %d/%d)..."):format(_onlineRetries, CDEV.MaxOnlineRetries or 6), "warn")   -- ★ lên UI
                WARN(("[cdev] 'already online' → backoff reconnect chờ orphan hết hạn (lần %d/%d, KHÔNG kick — tránh tự đá mình)"):format(_onlineRetries, CDEV.MaxOnlineRetries or 6))
                local s = sock; sock = nil; connecting = false
                if s then pcall(function() s:Close() end) end   -- đóng socket hiện tại (OnClose CŨNG gọi scheduleReconnect — guard dedup)
                scheduleReconnect()   -- ★ CHỈ qua scheduleReconnect (có reconnectPending guard) → ĐÚNG 1 reconnect dù OnClose cũng bắn. Backoff 5/10/20/40/80/160s ≈ 5' cho orphan reap
            else
                killDead(("account is online in another session (still online after %d tries → real duplicate)"):format(_onlineRetries))
            end
            return
        end
        -- ★ "key does not exist" = wrong token / server just restarted, key not loaded yet → close + reconnect (backoff);
        --   N CONSECUTIVE times (no login/data in between) → treat token as broken → DROP cdev (killDead), avoid spam.
        if isMsg and msg:find("does not exist", 1, true) then
            keyErr = keyErr + 1
            if keyErr >= (CDEV.MaxKeyErrors or 3) then
                if CDEV.KickOnBadKey then
                    kickInvalidKey(("key does not exist x%d → KEY INVALID"):format(keyErr))
                else
                    killDead(("wrong/expired token (key does not exist x%d)"):format(keyErr))
                end
            else
                setStatus(("Checking key (%d/%d)..."):format(keyErr, CDEV.MaxKeyErrors or 3), "warn")   -- ★ lên UI
                WARN(("[cdev] key does not exist (try %d/%d) → close, retry (backoff)"):format(keyErr, CDEV.MaxKeyErrors or 3))
                local s = sock; sock = nil
                if s then pcall(function() s:Close() end) end   -- → OnClose: scheduleReconnect (backoff)
            end
            return
        end
        LOG("[cdev] other msg: " .. msg:sub(1, 120))
    end

    -- server try order: IndexSV first, then 1..N (skip duplicates)
    local function order()
        local n, idx, seen, ord = #CDEV.Servers, CDEV.IndexSV or 1, {}, {}
        if CDEV.Servers[idx] then ord[#ord + 1] = idx; seen[idx] = true end
        if CDEV.StrictRegion and #ord > 0 then return ord end   -- ★ chỉ region getgenv().rn (vẫn đủ 3 link), KHÔNG sang region khác
        for i = 1, n do if not seen[i] then ord[#ord + 1] = i end end
        return ord
    end
    -- ★ linksOf(i): link của 1 region, thử THEO THỨ TỰ — connect được link nào DỪNG ngay. {scheme, host}.
    --   ★★ workers.dev (proxi) TRƯỚC: KHÔNG có Cloudflare proxy → WS stream message ỔN ĐỊNH (đúng link test tay nhận data OK).
    --   cdev.my (g_ws) CUỐI = FALLBACK: Cloudflare proxy có thể bắt tay 101 NHƯNG ko đẩy message → socket "connected" mà CÂM (server trả rỗng).
    --   → để cuối + có watchdog-câm (connect xong ko data N giây → xoá cache + reconnect link khác). Né bug "connect ổn mà ko nhận message".
    local function linksOf(i)
        local L, s, p = {}, CDEV.Servers[i], CDEV.Proxies and CDEV.Proxies[i]
        if p then
            L[#L + 1] = { "ws", p }                  -- Link1 (workers.dev ws — ỔN ĐỊNH NHẤT, ko Cloudflare proxy)
            L[#L + 1] = { "wss", p }                 -- Link2 (workers.dev wss)
        end
        if s then L[#L + 1] = { "ws", s } end       -- Link3 (cdev.my — FALLBACK, Cloudflare proxy hay câm)
        return L
    end
    local function urlFor(scheme, host)
        return scheme .. "://" .. host .. "/ConnectK=" .. CDEV.Key .. ".do"
    end

    -- ★ CACHE LINK ĐÃ CONNECT (writefile workspace): connect THÀNH CÔNG link nào → ghi ra đĩa → lần sau ưu tiên thử nó TRƯỚC.
    --   File { rn, scheme, host }. CHỈ dùng cache khi rn == region khách đang chọn (getgenv().rn); đổi rn → bỏ qua, dùng thứ tự thường + cache lại.
    local LINK_CACHE_FILE = "WNotifier_cdev_link.json"
    local _savedLink   -- "rn|scheme|host" in-memory → chỉ writefile khi ĐỔI (tránh ghi đĩa mỗi lần reconnect)
    local function loadCachedLink()
        if not (isfile and readfile and isfile(LINK_CACHE_FILE)) then return nil end
        local ok, t = pcall(function() return HttpService:JSONDecode(readfile(LINK_CACHE_FILE)) end)
        if ok and type(t) == "table" and type(t.scheme) == "string" and type(t.host) == "string" then   -- ★ ép string (JSON méo → table/number → bỏ qua, ko crash concat)
            _savedLink = tostring(t.rn) .. "|" .. t.scheme .. "|" .. t.host   -- nhớ để khỏi ghi lại nếu reconnect đúng link này
            return t
        end
        return nil
    end
    local function saveCachedLink(scheme, host)
        local str = tostring(CDEV.Region) .. "|" .. scheme .. "|" .. host
        if str == _savedLink then return end   -- link ko đổi → khỏi ghi
        _savedLink = str
        pcall(function() if writefile then writefile(LINK_CACHE_FILE, HttpService:JSONEncode({ rn = CDEV.Region, scheme = scheme, host = host })) end end)
        LOG("[cdev] cache link → " .. scheme .. "://" .. host .. " (rn " .. tostring(CDEV.Region) .. ")")
    end
    -- ★ XOÁ cache (link câm: connected nhưng ko đẩy message) → lần reconnect sau ko promote lại link hỏng đó
    local function clearCachedLink()
        _savedLink = nil
        pcall(function()
            if delfile and isfile and isfile(LINK_CACHE_FILE) then
                delfile(LINK_CACHE_FILE)
            elseif writefile then
                writefile(LINK_CACHE_FILE, "{}")   -- ★ ko có delfile → ghi đè rỗng: loadCachedLink ép scheme/host phải string nên "{}" bị bỏ qua → ko re-trap link câm cdev.my
            end
        end)
    end
    -- ★ thứ tự thử connect: build danh sách HỢP LỆ bình thường (region rn × 3 link) trước; rồi NẾU cache (cùng rn) CÒN nằm trong list → move lên ĐẦU.
    --   Cách "phải còn trong list" tự loại cache hỏng: đổi link (host cũ ko còn), đổi rn (rn khác), cache trỏ host khác region (StrictRegion). Dedup scheme|host.
    local function buildAttempts()
        local list, seen = {}, {}
        local function add(scheme, host)
            if not (scheme and host) then return end
            local k = scheme .. "|" .. host
            if not seen[k] then seen[k] = true; list[#list + 1] = { scheme, host } end
        end
        for _, i in ipairs(order()) do
            for _, lk in ipairs(linksOf(i)) do add(lk[1], lk[2]) end
        end
        -- ★ cache: CHỈ ưu tiên khi CÙNG rn VÀ link đó CÒN trong list hiện tại (né cache cũ / đổi link / sai region) → đưa lên đầu
        local c = loadCachedLink()
        if c and c.rn == CDEV.Region and seen[tostring(c.scheme) .. "|" .. tostring(c.host)] then
            for idx, a in ipairs(list) do
                if a[1] == c.scheme and a[2] == c.host then
                    table.remove(list, idx); table.insert(list, 1, a); break
                end
            end
        end
        return list
    end

    -- ★ KICK SESSION CŨ (Ad_KickKey): GET https://g_httpN.cdev.my/Ad_KickKey.do?<getgenv().Key> tới ĐÚNG host của region đang dùng
    --   (getgenv().rn → IndexSV → KickHosts[IndexSV]) → server ngắt session cũ của key này TRƯỚC khi connect. KHÔNG kick cả 4 host.
    --   Trị lỗi "already online / 2 session" do server chưa kịp disconnect session cũ (hop/rejoin/re-exec nhanh). Best-effort, ko block.
    function kickOtherSessions()
        local key = tostring(CDEV.Key or (getgenv and getgenv().Key) or "")
        local hosts = CDEV.KickHosts or {}
        local h = hosts[CDEV.IndexSV or 1]   -- ★ CHỈ kick region của mình (getgenv().rn), ko spam cả 4
        if key == "" or not httpRequest or not h then return end
        -- ★ CHẠY ĐỒNG BỘ (caller start() đã ở trong task.spawn) → start() biết kick XONG để connect NGAY (ko chờ mù). HTTP TRƯỚC, HTTPS fallback:
        --   g_httpN.cdev.my có dấu "_" → executor (Volt) TLS lỗi SEC_E_INVALID_TOKEN với https; http:// (port 80, ko TLS) chạy được +
        --   server Express trả {"Code":1,"Msg":"OK"} = kick THẬT. http ok thì break luôn → ko đụng https (nhanh ~0.2s).
        for _, sch in ipairs(CDEV.KickSchemes or { CDEV.KickScheme or "http", "https" }) do
            local url = sch .. "://" .. h .. (CDEV.KickPath or "/Ad_KickKey.do") .. "?" .. key
            local ok, r = pcall(httpRequest, { Url = url, Method = "GET" })
            -- ★ LOG kết quả: kick mãi vẫn "already online" → xem đây (200=ok / 404=sai path / ERR=TLS/host) để biết lỗi server hay client
            local code = (ok and type(r) == "table") and (r.StatusCode or r.Status or r.status_code) or nil
            local body = (ok and type(r) == "table") and tostring(r.Body or ""):sub(1, 80) or ""
            LOG("[cdev] kick " .. sch .. "://" .. h .. " (region " .. tostring(CDEV.Region) .. ") → " .. (ok and ("HTTP " .. tostring(code) .. (body ~= "" and (" " .. body) or "")) or ("ERR " .. tostring(r))))
            if ok and (code == 200 or code == "200" or (type(body) == "string" and body:find('"Code":1', 1, true))) then break end   -- kick OK → khỏi thử scheme sau (tránh kick 2 lần)
        end
    end

    -- scheduleReconnect: lập lịch reconnect BACKOFF ×2 (ReconnectSec=2 → 2/4/8/16/32/64/128/180s, ceiling MaxReconnectSec), reset khi login-ok/data. reconnectPending → đúng 1 cái chờ.
    function scheduleReconnect()
        if killed or not isCurrentGen() then return end   -- ★ OLD exec (re-run) → ngừng reconnect (chống loop cũ leak khi chạy lại ko rejoin)
        if reconnectPending then return end   -- ★ đã có 1 reconnect đang chờ → BỎ (chống OnClose + nhánh khác lập lịch chồng → bão session)
        reconnectPending = true
        failures = failures + 1
        -- ★ cap số mũ ở 7 (ko phải 4) → backoff thật sự leo tới trần MaxReconnectSec; early reconnect VẪN nhanh (2/4/8s), chỉ chậm dần khi fail liên tục (chống spam orphan)
        local d = math.min((CDEV.ReconnectSec or 5) * (2 ^ math.min(failures - 1, 7)), CDEV.MaxReconnectSec or 60)
        LOG(("[cdev] reconnect in %ds (consecutive fail #%d)"):format(d, failures))
        task.delay(d, function() reconnectPending = false; connect() end)   -- ★ nhả cờ NGAY TRƯỚC connect → connect() fail có thể lập lịch lại (vẫn 1 tại 1 thời điểm)
    end

    function connect()
        if killed or not isCurrentGen() then return end   -- ★ disconnected / OLD exec (đã re-run) → KHÔNG connect
        if not (CDEV.Enabled and WSLib and #CDEV.Servers > 0) or sock or connecting then return end
        connecting = true
        if WN_STATUS_KIND ~= "ok" then setStatus("Connecting...", "warn") end   -- ★ lên UI (đã Live thì khỏi nháy)
        local attempt = connAttempt + 1; connAttempt = attempt   -- ★ token của LẦN connect này
        -- ★ WATCHDOG (fix HIGH): WSLib(u) trên nhiều executor là call CHẶN/yield KHÔNG timeout — nếu relay half-open/handshake treo,
        --   coroutine park mãi → `connecting` kẹt true → mọi reconnect sau bị guard chặn → notifier CHẾT CÂM. Sau ConnectTimeoutSec
        --   nếu attempt này vẫn treo (connAttempt chưa đổi, chưa có sock) → ép connecting=false + scheduleReconnect để tự hồi.
        task.delay(CDEV.ConnectTimeoutSec or 25, function()
            if connAttempt == attempt and connecting and not sock then
                WARN("[cdev] connect attempt treo > " .. tostring(CDEV.ConnectTimeoutSec or 25) .. "s → ép reconnect")
                connecting = false
                connAttempt = attempt + 1   -- vô hiệu attempt treo: nếu coroutine cũ unpark sau này nó sẽ thấy connAttempt khác → bỏ kết quả
                scheduleReconnect()
            end
        end)
        task.spawn(function()
            local s, sScheme, sHost
            for _, a in ipairs(buildAttempts()) do               -- ★ link CACHE (cùng rn) TRƯỚC → rồi region rn × link; connect được link nào DỪNG
                local u = urlFor(a[1], a[2])
                local ok, sk = pcall(function() return WSLib(u) end)
                if ok and sk then s = sk; sScheme, sHost = a[1], a[2]; LOG("[cdev] connected " .. a[1] .. "://" .. a[2]); break   -- ★ LOG (Debug-gated, BỎ key khỏi URL) → prod ko in lộ key/host. CHƯA cache vội — socket có thể CÂM (cdev.my qua Cloudflare 101-nhưng-ko-message). Chỉ cache khi NHẬN DATA (watchdog dưới).
                else LOG("[cdev] connect fail " .. a[1] .. "://" .. a[2]) end
            end
            connecting = false
            -- ★ Nếu attempt này đã bị watchdog (hoặc lần connect mới) thay thế → BỎ socket vừa mở (tránh 2 socket sống song song → tự "already online")
            if connAttempt ~= attempt then
                if s then pcall(function() s:Close() end) end
                return
            end
            if s then
                sock = s
                LOG("[cdev] socket CONNECTED ✓ → chờ InfoAcc (Money) rồi gửi GetData2")   -- ★ xác nhận WS đã mở
                pcall(function() getgenv().__wn_sk = function() pcall(function() s:Close() end) end end)   -- ★ lưu HÀM ĐÓNG (ko expose socket → ko bị OnMessage-tap qua getgenv); re-exec gọi để đóng socket cũ (chống leak)
                pcall(function() s.OnMessage:Connect(function(m) pcall(onMsg, m, s) end) end)   -- ★ truyền `s` → onMsg bỏ frame trễ từ socket cũ (chống đóng nhầm socket mới)
                pcall(function() s.OnClose:Connect(function() sock = nil; scheduleReconnect() end) end)
                _infoAccGot = false   -- ★ reset cho kết nối mới
                keyLogin = nil        -- ★ NEW PROTOCOL: reset, chờ InfoAcc của kết nối mới đưa Money về
                _msgLogN = 0          -- ★ reset log-count cho kết nối mới
                -- ★ NEW PROTOCOL: server TỰ gửi InfoAcc lúc connect → CHỜ lấy Money→keyLogin RỒI gửi "GetData2||Name||kk" (kk=(keyLogin^2727)+9090).
                --   (thay "GetData||Name" cũ; "gateway sẵn sàng" giờ = đã nhận InfoAcc → khỏi GetDataDelay đoán mò.)
                task.spawn(function()
                    for _ = 1, 40 do   -- chờ tối đa ~10s cho InfoAcc/keyLogin về
                        if sock ~= s or not isCurrentGen() then return end
                        if keyLogin ~= nil then break end
                        task.wait(0.25)
                    end
                    if sock ~= s or not isCurrentGen() then return end
                    if keyLogin ~= nil then
                        local kk = jsXor32(keyLogin, 2727) + 9090   -- kk = (keyLogin ^ 2727) + 9090 (JS int32)
                        pcall(function() s:Send("GetData2||" .. CDEV.Name .. "||" .. tostring(kk)) end)   -- get full data + register for Update
                        LOG("[cdev] GetData2 sent (kk=" .. tostring(kk) .. ")")
                    else
                        pcall(function() s:Send("GetData||" .. CDEV.Name) end)   -- ★ FALLBACK server CŨ (ko gửi "Money") → GetData cũ → backward-compat, region chưa update KHÔNG hỏng
                        LOG("[cdev] GetData (fallback — server ko gửi Money)")
                    end
                end)
                -- ★★ WATCHDOG SOCKET CÂM (RE-ARM) + CACHE-ON-DATA: cdev.my qua Cloudflare có thể bắt tay 101 NHƯNG KO đẩy message → socket "connected" mà CÂM (server trả rỗng).
                --   Nhận data/ping → cache link (1 LẦN, ko return: vẫn canh tiếp). MỌI frame cập nhật _lastMsgAt. Ngừng nhận frame BẤT KỲ quá SilentLinkSec giây
                --   (câm từ đầu HOẶC stream-1-lần-rồi-tịt như cdev.my) → reconnect link khác. Chưa từng cache (hỏng từ đầu) → xoá cache + reset backoff → landing workers.dev NHANH trước anti-crack 180s.
                do
                    local connAt = os.clock()
                    task.spawn(function()
                        local cached = false
                        while sock == s and isCurrentGen() do
                            if (lastServerPing or 0) > connAt and not cached then saveCachedLink(sScheme, sHost); cached = true end   -- nhận DATA/PING → link ngon → cache 1 lần
                            local lastSeen = math.max(_lastMsgAt or 0, connAt)
                            if os.clock() - lastSeen > (CDEV.SilentLinkSec or 10) then
                                WARN(("[cdev] link CÂM (%ds ko frame nào) → %sreconnect link khác"):format(CDEV.SilentLinkSec or 10, cached and "" or "xoá cache + "))
                                if not cached then clearCachedLink(); failures = 0 end   -- hỏng từ đầu → xoá cache + reset backoff (landing link ngon nhanh)
                                local old = sock; sock = nil
                                if old then pcall(function() old:Close() end) end   -- OnClose → scheduleReconnect (thử link khác, vd workers.dev)
                                return
                            end
                            task.wait(0.25)
                        end
                    end)
                end
                -- ★ LẤY InfoAcc (chứa VipText): nếu sau grace vẫn CHƯA nhận InfoAcc → gửi "GetInfoMe" → server trả về
                --   InfoAcc||Login successful||{...VipText...}. Retry mỗi 2s tới khi nhận / đổi socket / re-exec (~tối đa 12s rồi thôi).
                task.spawn(function()
                    task.wait(0.4)   -- chờ InfoAcc tự về trước (nếu gateway auto-gửi); hạ 1→0.4 cho VipText load nhanh hơn
                    for _ = 1, 6 do
                        if sock ~= s or not isCurrentGen() or _infoAccGot then return end
                        pcall(function() s:Send("GetInfoMe") end)
                        task.wait(2)
                    end
                end)
                -- ★ HEARTBEAT (HeartbeatSec): định kỳ gửi "Ping||<time>" để gateway có cái phản hồi (server đẩy Ping lại →
                --   lastServerPing reset). Nếu KHÔNG có, client idle lúc relay VẮNG find sẽ bị anti-crack watchdog shutdown NHẦM
                --   sau PingTimeoutSec. Loop tự thoát khi socket đổi (reconnect tạo s mới) / re-exec (isCurrentGen false) / killed.
                task.spawn(function()
                    -- ★ NEW PROTOCOL Ping (JS Timer5Seconde): CHỈ ping khi ĐÃ LOGIN (keyLogin/Money) → mỗi 5s KỂ TỪ login.
                    --   TRƯỚC login KHÔNG ping (JS else = ko gửi) → tránh gửi ping SAI-FORMAT lên server mới lúc chưa có Money.
                    local _pingLogged = false
                    local _t0 = os.clock()
                    while sock == s and isCurrentGen() do
                        if keyLogin ~= nil then
                            -- ĐÃ LOGIN → Ping: kk=(keyLogin*2462)+9090 · rr=rand(1000,9999) · k3=kk^rr → "Ping||Name||<rr><k3>"
                            local kk = (keyLogin * 2462) + 9090
                            local rr = math.random(1000, 9999)
                            local k3 = jsXor32(kk, rr)   -- k3 = kk ^ rr (JS int32; kk có thể > 2^32 → jsXor32 mod trước)
                            local payload = "Ping||" .. (CDEV.Name or "Game01") .. "||" .. tostring(rr) .. tostring(k3)
                            pcall(function() s:Send(payload) end)
                            if not _pingLogged then _pingLogged = true; LOG(("[cdev] PING mới ✓ %s  (kMoney=%s kk=%s rr=%s k3=%s) — mỗi 5s KỂ TỪ login"):format(payload, tostring(keyLogin), tostring(kk), tostring(rr), tostring(k3))) end
                            task.wait(CDEV.HeartbeatSec or 5)   -- ★ 5s KỂ TỪ login, liên tục
                        elseif (os.clock() - _t0) > (CDEV.OldPingGraceSec or 10) then
                            pcall(function() s:Send("Ping||" .. tostring(os.clock())) end)   -- ★ server CŨ (>10s ko gửi Money) → ping cũ keepalive (backward-compat, ko rớt session)
                            task.wait(CDEV.HeartbeatSec or 5)
                        else
                            task.wait(0.25)   -- ★ đang chờ login (InfoAcc/Money) → KHÔNG ping (như JS `else`) → server mới ko nhận ping sai lúc chưa login
                        end
                        if sock ~= s or not isCurrentGen() then break end
                    end
                end)
            else
                scheduleReconnect()   -- all servers failed → retry with backoff (scheduleReconnect checks killed itself)
            end
        end)
    end

    -- ★ ANTI-CRACK PING WATCHDOG: server pushes "Ping||" (+ data/login) to the VALID client. After the initial grace, if NO
    --   server signal is received within PingTimeoutSec seconds → game:Shutdown() (+ Kick fallback). Blocks freeloading / stub WS /
    --   token sharing (gets "already online" → killed → stops receiving ping → also shuts down). Runs even when killed.
    if CDEV.Enabled then
        task.spawn(function()
            task.wait(CDEV.PingGraceSec or 40)   -- grace: wait for connect + login + first ping (don't shutdown right after load)
            while true do
                task.wait(2)
                if not isCurrentGen() then return end   -- ★ OLD exec (already re-run) → STOP, do NOT fire Shutdown by mistake on the new gen
                -- (đã XOÁ bẫy decoy getgenv __WN_AUTHED/__WN_KILLED — user: bỏ thứ bảo mật)
                -- ★ socket ĐANG mở + đã từng AUTHED + vẫn nhận frame gần đây (_lastMsgAt) → coi là CÒN SỐNG dù gateway KHÔNG echo Ping lúc server vắng find → tránh Shutdown NHẦM.
                --   Gated AUTHED (chỉ true sau tín hiệu server THẬT) → stub WS chưa login KHÔNG thoát được nhánh này.
                local socketAlive = (sock ~= nil) and AUTHED and ((os.clock() - (_lastMsgAt or 0)) < (CDEV.PingTimeoutSec or 180))
                if not socketAlive and (os.clock() - lastServerPing) > (CDEV.PingTimeoutSec or 20) then
                    WARN(("[cdev] NO server signal received >%ds → game:Shutdown() (anti-crack)"):format(CDEV.PingTimeoutSec or 20))
                    -- pcall(function() game:Shutdown() end)
                    pcall(function() LocalPlayer:Kick("[WN] CONN") end)   -- ★ mã ngắn; lý do đầy đủ ở WARN log
                    return
                end
            end
        end)
    end

    -- ★ start(): kick session cũ ĐÚNG 1 LẦN rồi connect NGAY sau khi kick XONG. Reconnect sau gọi thẳng connect() → KHÔNG kick lại.
    --   ⚠️ kick chạy CO-ROUTINE RIÊNG (httpRequest đồng bộ + ko có Timeout → có thể TREO nếu https fallback half-open) → KHÔNG để nó
    --   block connect. start() chờ kick xong HOẶC tối đa KickMaxWaitSec rồi connect → vẫn "kick xong connect ngay" mà ko bao giờ kẹt (chống game tự Shutdown sau ~180s).
    local function start()
        if not CDEV.KickOnStart then connect(); return end   -- ★ kick TẮT (server tự kick session cũ) → connect thẳng, nhanh nhất
        task.spawn(function()
            local kicked = false
            task.spawn(function() pcall(kickOtherSessions); kicked = true end)   -- kick ko block connect
            local acc, cap = 0, CDEV.KickMaxWaitSec or 3
            while not kicked and acc < cap do acc = acc + task.wait(0.1) end       -- chờ kick xong, trần KickMaxWaitSec (chống treo)
            if (CDEV.KickSettleSec or 0) > 0 then task.wait(CDEV.KickSettleSec) end  -- buffer reap (nếu set >0; mặc định 0 = connect ngay)
            connect()
        end)
    end
    -- ★ revive(): RECONNECT MỀM (nút Rejoin) — hồi sinh sau killDead (Kick by admin / network) MÀ KHÔNG cần out game.
    --   Reset killed + counters, đóng socket cũ (server thấy 1 connect mới sạch), connect lại. KHÔNG hồi key INVALID (BLOCKED).
    local function revive()
        if BLOCKED then setStatus("Invalid key — get new key", "err"); return false end   -- key sai/hết hạn → ko hồi
        killed = false; connecting = false; reconnectPending = false
        failures, keyErr, _onlineRetries, _kickRetries = 0, 0, 0, 0
        local s = sock; sock = nil
        if s then pcall(function() s:Close() end) end   -- đóng socket cũ → server reap session cũ, connect mới ko bị "already online" của chính mình
        connAttempt = connAttempt + 1   -- vô hiệu mọi attempt treo cũ
        lastServerPing = os.clock()     -- reset anti-crack mốc → ko Shutdown nhầm lúc đang reconnect tay
        setStatus("Reconnecting...", "warn")
        task.spawn(function() task.wait(0.3); pcall(start) end)   -- chờ chút cho socket cũ đóng hẳn rồi connect (tránh tự "already online")
        return true
    end
    local M = { start = start, connect = connect, revive = revive, getData = function() return _cdevRT.data end, connected = function() return sock ~= nil end }
    return M   -- ★ KHÔNG expose getgenv().__CDEV nữa (chống đọc feed qua global)
end)()

-- ── game modules (safeRequire) ──
local function safeRequire(...)
    local args = { ... }
    local ok, m = pcall(function()
        local cur = ReplicatedStorage
        for _, n in ipairs(args) do cur = cur:WaitForChild(n, 8); if not cur then error("missing " .. n) end end
        return require(cur)
    end)
    return ok and m or nil
end
local Animals       = safeRequire("Datas", "Animals") or {}
local SharedAnimals = safeRequire("Shared", "Animals")
local NumberUtils   = safeRequire("Utils", "NumberUtils")

local function fmt(n)
    n = tonumber(n) or 0
    if NumberUtils then
        local ok, s = pcall(function() return NumberUtils:ToString(n) end)
        if ok and type(s) == "string" and s ~= "" then return s end
    end
    for _, u in ipairs({ {1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"} }) do
        if n >= u[1] then return ("%.2f%s"):format(n / u[1], u[2]) end
    end
    return tostring(math.floor(n))
end

-- ★ parseGen: đọc input rút gọn → số. "100m"→100000000, "1.5b"→1.5e9, "250k"→250000, "100000000"→100000000, "100,000"→100000.
local function parseGen(text)
    text = tostring(text or ""):lower():gsub("[%s,]", "")            -- bỏ khoảng trắng + dấu phẩy
    local num, suf = text:match("^([%d%.]+)([kmbt]?)")
    local n = tonumber(num)
    if not n then return 0 end
    local mult = ({ k = 1e3, m = 1e6, b = 1e9, t = 1e12 })[suf] or 1
    return math.floor(n * mult)
end
-- ★ fmtGen: số → chuỗi gọn round-trip với parseGen. 100000000→"100M", 1500000000→"1.5B", 0→"0".
local function fmtGen(n)
    n = tonumber(n) or 0
    if n <= 0 then return "0" end
    for _, u in ipairs({ {1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"} }) do
        if n >= u[1] then
            local v = n / u[1]
            if v % 1 == 0 then return ("%d%s"):format(v, u[2]) end
            return (("%.2f"):format(v):gsub("%.?0+$", "")) .. u[2]
        end
    end
    return ("%d"):format(math.floor(n))
end

-- ── mutation / traits / $/s ──
-- ★ FIX wrong money report: at HARVEST the brainrot renders via the ClientRenderBrainrot tag using attr __render_mutation /
--   __render_traits (StealController) — DIFFERENT from __mutation / _Trait.* of an ALREADY-PLACED brainrot. Read BOTH forms (prefer
--   the placed form) → don't miss mutation → GetGeneration gives correct $/s (e.g. Diamond = base×1.5), instead of falling back to base.
local function mutationOf(model)
    local m = model:GetAttribute("__mutation") or model:GetAttribute("Mutation") or model:GetAttribute("__render_mutation")
    if m == nil or m == "" then return nil end
    return tostring(m)
end
local function traitsOf(model)
    local traits
    for _, c in ipairs(model:GetChildren()) do
        local tn = c.Name:match("^_Trait%.(.+)$")
        if tn then traits = traits or {}; traits[#traits + 1] = tn end
    end
    if not traits then   -- render fallback form: __render_traits = JSON array of trait names
        local rt = model:GetAttribute("__render_traits")
        if type(rt) == "string" and rt ~= "" and rt ~= "[]" then
            local ok, d = pcall(function() return HttpService:JSONDecode(rt) end)
            if ok and type(d) == "table" and #d > 0 then traits = d end
        end
    end
    return traits
end
local function overheadGen(model)  -- fallback: read "$X/s" from the overhead
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("TextLabel") and d.Name == "Generation" and d.Text ~= "" and d.Text ~= "$0/s" then
            local s = d.Text:gsub("%$", ""):gsub("/s", ""):gsub(",", ""):gsub("%s", "")
            local num, suf = s:match("([%d%.]+)%s*([KMBT]*)")
            num = tonumber(num)
            if num then return num * (({K=1e3,M=1e6,B=1e9,T=1e12})[suf] or 1) end
        end
    end
    return nil
end
local function genOf(name, model)
    local mut = mutationOf(model)
    local tr  = traitsOf(model)
    if SharedAnimals then
        local ok, g = pcall(function() return SharedAnimals:GetGeneration(name, mut, tr, nil) end)
        if ok and type(g) == "number" and g > 0 then return g, mut, tr end
    end
    local oh = overheadGen(model)
    if oh and oh > 0 then return oh, mut, tr end
    local d = Animals[name]
    return (d and tonumber(d.Generation)) or 0, mut, tr
end

