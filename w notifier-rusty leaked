local function startSessionTracker(apiKey)
    task.spawn(function()
        pcall(function()
            local WS_BASE = "wss://api.wnotifier.com"
            local plr = LocalPlayer
            local url = ("%s/api/v1/stream?key=%s&rbx_user=%s&rbx_id=%s"):format(
                WS_BASE, tostring(apiKey), tostring(REAL_NAME), tostring(plr.UserId))
            -- ★ chụp connect fn 1 lần (nhiều tên tuỳ executor); ko có ws API → return → _sessConnected mãi false → watchdog kick
            local connect = (syn and syn.websocket and syn.websocket.connect)
                or (WebSocket and WebSocket.connect)
                or (websocket and websocket.connect)
            if not connect then return end
            local backoff = 0
            while isCurrentGen() do
                local connOk, conn = pcall(connect, url)
                if connOk and conn then
                    backoff = 0
                    local closed = false
                    pcall(function()
                        conn.OnClose:Connect(function() closed = true end)
                        conn.OnMessage:Connect(function() _sessLastAlive = os.clock() end)   -- ★ server frame = bằng chứng sống MẠNH nhất
                    end)
                    -- ★ thiết lập THẬT: gửi 1 frame ngay; gửi lỗi = socket ảo/hook rởm/chết → KHÔNG tính là connected
                    if pcall(function() conn:Send("Ping||" .. tostring(os.clock())) end) then
                        _sessConnected = true
                        _sessLastAlive = os.clock()
                    end
                    -- ★ heartbeat: còn mở thì định kỳ gửi + refresh alive; gửi lỗi → coi như đóng → thoát để reconnect
                    while (not closed) and isCurrentGen() do
                        task.wait(CONFIG.SessionPingSec or 5)
                        if closed or not isCurrentGen() then break end
                        if not pcall(function() conn:Send("Ping||" .. tostring(os.clock())) end) then break end
                        _sessLastAlive = os.clock()
                    end
                    _sessConnected = false
                    pcall(function() conn:Close() end)
                end
                if not isCurrentGen() then break end
                backoff = backoff + 1
                task.wait(math.min(3 * backoff, 30))   -- ★ backoff reconnect (rớt tạm thời tự hồi); watchdog mới là bên quyết định kick khi stale
            end
        end)
    end)
end

-- ★ WATCHDOG ĐỘC LẬP — enforce "phải online wss". Tách khỏi tracker để hook/no-op tracker vẫn bị tóm (cờ ko lên → kick).
--   Pha 1: chờ connect lần đầu trong SessionGraceSec, quá → kick. Pha 2: đã connect rồi mà mất liveness > SessionStaleSec → kick.
local function startSessionWatchdog()
    task.spawn(function()
        pcall(function()
            local grace = CONFIG.SessionGraceSec or 40
            local stale = CONFIG.SessionStaleSec or 90
            local t0 = os.clock()
            while isCurrentGen() and (not _sessConnected) do   -- pha 1: chờ thiết lập lần đầu
                if (os.clock() - t0) > grace then
                    sessionBlockKick(("could not connect wss within %ds"):format(grace)); return
                end
                task.wait(1)
            end
            while isCurrentGen() do                              -- pha 2: canh rớt/stale sau khi đã connect
                if (os.clock() - _sessLastAlive) > stale then
                    sessionBlockKick(("session dropped (no liveness for %ds)"):format(stale)); return
                end
                task.wait(2)
            end
        end)
    end)
end

