local _sessConnected = false   -- ★ đã THẬT SỰ thiết lập được wss (send frame OK) ít nhất 1 lần
local _sessLastAlive = 0       -- ★ os.clock() lần cuối CHỨNG MINH còn sống (connect / heartbeat-send OK / nhận server frame)
local _sessKilled    = false   -- ★ đã block+kick rồi (idempotent, khỏi kick 2 lần)

-- ★ block+kick: set BLOCKED (isCurrentGen=false ở MỌI loop/webhook/auto-join → dừng ngay) + AUTHED=false (ko gửi wh) + Kick.
local function sessionBlockKick(reason)
    if _sessKilled then return end
    _sessKilled = true
    BLOCKED = true; AUTHED = false
