local function joinServer(placeId, jobId, attempts)
    if not (placeId and jobId) then notify("W Notifier", "Missing server info", 4); return false end
    attempts = tonumber(attempts) or 1
    if attempts <= 1 then
        if os.clock() - _lastTpAt < 1.5 then return false end -- Tăng delay chống spam đơn
        _lastTpAt = os.clock()
        notify("W Notifier", "Joining server...", 2)
        task.spawn(function()
            applySilentTeleport()
            local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer) end)
            if not ok then WARN("teleport (server full/closed?):", err) end
        end)
        return true
    end

    if _joinActive then _joinActive = false; notify("W Notifier", "Force-join cancelled", 3); return false end
    _joinActive = true
    _forceGen = _forceGen + 1; local myGen = _forceGen
    _forceMax = attempts; _forceAttempt = 0; _forceJobId = jobId
    notify("W Notifier", ("Force joining (up to %d tries)..."):format(attempts), 4)
    
    task.spawn(function()
        applySilentTeleport()   -- ★ 1 LẦN trước loop (ko spam SetTeleportGui trong loop)
        local spam   = CONFIG.ForceSpam == true   -- ★ SPAM MODE: bỏ qua gap, poll mỗi frame → max teleport/s (BẤT CHẤP delay/crash)
        local minGap = spam and 0 or math.max(CONFIG.ForceRetryMin or 0.5, 0)     -- ★ SÀN snipe: gap khi server full BÁO FAIL. CHO PHÉP 0 (user cần min 0s) = snipe nhanh nhất. AN TOÀN ko-0-gap nhờ maxGap≥0.1 (while LUÔN chạy ≥1 task.wait) + _forceFailed reset=false ngay trước teleport & set ASYNC (event frame sau) → check (2) ko break ở lần poll đầu. Rate trần ~10/s (poll-gated).
        local maxGap = spam and math.max(CONFIG.ForceSpamGap or 0.01, 0.005) or math.max(CONFIG.ForceDelay or 2, minGap, 0.1) -- ★ TRẦN khi KO báo fail + SÀN AN TOÀN 0.1: ĐẢM BẢO while chạy ≥1 lần (1 task.wait yield) → chống 0-yield tight-loop CRASH. spam: dùng ForceSpamGap (floor 0.005 = vẫn ≥1 yield, bắn mỗi frame).
        local pollW  = spam and 0 or 0.1                              -- ★ spam: task.wait(0)=1 frame → bắn lại ~mỗi frame (~fps/s). thường: 0.1s (trần ~10/s an toàn)
        local _floodStreak = 0   -- ★ số lần Flooded LIÊN TIẾP (adaptive backoff: dai thì lùi lâu hơn)
        for i = 1, attempts do
            if not _joinActive or _forceGen ~= myGen then break end
            -- ★★ FLOOD-AWARE (ADAPTIVE): Flooded (Roblox rate-limit teleport) → backoff = base × số-lần-Flooded-LIÊN-TIẾP (cap ForceFloodBackoffMax).
            --   GameFull (server full) → KHÔNG backoff, bắn lại NGAY + reset streak. Block dai → lùi dần lâu hơn cho rate-limit hạ; transient → lùi ngắn (giữ nhanh).
            if (CONFIG.ForceFloodBackoff or 0) > 0 and _forceFailResult == Enum.TeleportResult.Flooded then
                _floodStreak = _floodStreak + 1
                local bo = math.min((CONFIG.ForceFloodBackoff or 0.8) * _floodStreak, CONFIG.ForceFloodBackoffMax or 5)
                local t0 = os.clock()
                while os.clock() - t0 < bo do
                    if not _joinActive or _forceGen ~= myGen then break end
                    task.wait(0.05)
                end
            else
                _floodStreak = 0   -- lần trước KO Flooded (GameFull / chưa fail) → reset chuỗi
            end
            _forceAttempt = i
            _forceFailed = false
            _forceFailResult = nil   -- ★ reset trước teleport mới (handler set lại nếu fail)
            local tpAt = os.clock(); _lastTpAt = tpAt
            pcall(function() TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer) end)
            -- ★★ FAIL-AWARE SNIPE: server full → TeleportInitFailed bật _forceFailed → bắn lại NGAY khi đủ SÀN minGap (snipe nhanh = bắt slot trống tốt hơn). KHÔNG có
            --   tín hiệu fail (teleport treo) → chờ tới maxGap (kiên nhẫn). Floor minGap chống crash. Vào được → script chết. CONFIG vẫn xài:
            --   ForceRetryMin = tốc độ snipe (full server, cái CHÍNH) · ForceDelay = trần chờ khi no-fail · ForceAttempts = số lần.
            local deadline = tpAt + maxGap
            while os.clock() < deadline do
                if not _joinActive or _forceGen ~= myGen then break end                 -- cancel / có force MỚI → thoát NGAY
                if _forceFailed and (os.clock() - tpAt) >= minGap then break end          -- ★ fail xác nhận + đủ sàn → bắn lại NGAY (ko phí phần đuôi maxGap)
                task.wait(pollW)
            end
        end
        if _forceGen == myGen then _joinActive = false; _forceAttempt = 0; _forceJobId = nil end
    end)
    return true
end
