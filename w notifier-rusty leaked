	local function updateLive()
		local kind = WN_STATUS_KIND
		local connected = false
		pcall(function() connected = (Cdev and Cdev.connected and Cdev.connected()) and true or false end)
		-- ★ "Live" cũ nhưng socket đã rớt (silent drop trước khi event reconnect bắn) → coi như đang reconnect
		local stale = (kind == "ok" and not connected)
		if stale then kind = "warn" end
		local kc = (kind == "ok" and C.Mint) or (kind == "warn" and C.Amber) or (kind == "err" and C.Rose) or C.Mut
		-- dòng status chi tiết
		if kind == "ok" then statusLabel.Text = "Connected"
		elseif stale then statusLabel.Text = "Reconnecting..."
		else statusLabel.Text = WN_STATUS end
		statusLabel.TextColor3 = kc
		-- chip Live + chấm trên pill (đồng bộ màu kind)
		liveDot.BackgroundColor3 = kc
		liveLabel.Text = (kind == "ok" and "Live") or (kind == "err" and "Error") or (kind == "warn" and "Sync") or "Off"
		liveLabel.TextColor3 = kc
		pillDot.BackgroundColor3 = kc
	end

	-- ★ whitelist GỘP (dùng chung auto-join): đã whitelist con nào → CHỈ hiện server có brainrot trong WL_AJ, ĐÚNG mutation, money ≥ min
	--   (vd Garama min 1B → con 50M ẩn). Whitelist trống → hiện HẾT (chưa cấu hình = ko lọc). Đọc CÙNG WL_AJ như autoMatches → logs khớp y auto-join.
	local function wlAllows(s)
		if not next(WL_AJ.entries) then return true end
		local nm, mt = parseBest(s.best)
		local e = WL_AJ.entries[tostring(nm):lower()]
		if e == nil then return false end
		if e.mut and e.mut ~= "Any" and tostring(e.mut):lower() ~= tostring(mt):lower() then return false end   -- ★ chọn mutation cụ thể → con khác mutation bị ẩn
		if (tonumber(s.money) or 0) < (tonumber(e.min) or 0) then return false end   -- ★ dưới ngưỡng → ẩn khỏi logs
		return true
	end
	-- wsServers → rows cho UI mới (dedup theo jobId, lọc qua passesFilter = VIP + fusing + whitelist, cap ServerListMax)
	local _lastFeedSig   -- ★ SIG-SKIP: chữ ký top-N hiển thị; ko đổi → bỏ WNSetRows (35 update + sort + bars). Reset trong clearAll.
	local function feedRows()
		if minimized then return end
		local now = os.time()
		local byJob = {}
		for _, s in pairs(wsServers) do
			if passesFilter(s) and wlAllows(s) then
				local ex = byJob[s.jobId]
				if (not ex) or (tonumber(s.money) or 0) > (tonumber(ex.money) or 0) then byJob[s.jobId] = s end
			end
		end
		local arr = {}
		for _, s in pairs(byJob) do arr[#arr+1] = s end
		table.sort(arr, function(a, b)   -- ★ TIER cao lên đầu trước khi cap (con tier cao ko bị cắt), cùng tier mới so $/s
			local ra, rb = tierRankOf(a.tier), tierRankOf(b.tier)
			if ra ~= rb then return ra > rb end
			return (tonumber(a.money) or 0) > (tonumber(b.money) or 0)
		end)
		local MAX = CONFIG.ServerListMax or 35
		local rows = {}
		for i = 1, math.min(#arr, MAX) do
			local s = arr[i]
			local nm, mt = parseBest(s.best)
			local ageSec = math.max(0, now - (s.seen or now))
			local tierTxt = (s.tier ~= "" and string.upper(s.tier)) or "FIND"
			rows[#rows+1] = {
				uid = s.jobId, jobId = s.jobId,
				name = (nm ~= "" and nm) or tostring(s.best),
				rarity = tierToRarity(s.tier),
				tierLabel = ((mt ~= "" and (string.upper(mt) .. "  •  ")) or "") .. tierTxt,
				gen = "$" .. fmt(s.money) .. "/s",
				money = tonumber(s.money) or 0,
				time = os.clock() - ageSec,
			}
		end
		-- ★ SIG-SKIP: top-N (uid|money|tierLabel|gen) y hệt lần trước → server off-screen churn → KHÔNG đụng card (bỏ 35 update + sort + bars).
		--   KHÔNG đưa `time` vào sig (đổi mỗi call; age đã do ticker riêng cập nhật theo startTime).
		local sp = {}
		for i = 1, #rows do local r = rows[i]; sp[i] = r.uid .. "~" .. r.money .. "~" .. tostring(r.tierLabel) .. "~" .. tostring(r.gen) end
		local sig = table.concat(sp, "|")
		if sig == _lastFeedSig then return end
		_lastFeedSig = sig
		WNSetRows(rows)
	end
