-- POST with retry (Discord 429 / network error → retry)
-- ★ postJson — RELIABLE Discord webhook POST (must be as reliable as /game-data/steal so the two stay 1:1).
--   Retries until WebhookMaxWaitSec, HONORS Discord's 429 Retry-After (header or JSON body), reads the status code across
--   executor field names (StatusCode/Status/status_code), and LOGS why it finally failed. Returns true only on real delivery.
local function postJson(url, payload)
    if not url or url == "" or url == "PASTE_WEBHOOK_HERE" or not httpRequest then return false end
    local body = HttpService:JSONEncode(payload)
    local deadline = os.clock() + (CONFIG.WebhookMaxWaitSec or 25)
    local attempt = 0
    repeat
        attempt = attempt + 1
        local ok, res = pcall(httpRequest, {
            Url = url, Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        if not ok then
            task.wait(0.8)   -- request THREW (network/executor) → brief wait, retry
        else
            local code = tonumber(res and (res.StatusCode or res.Status or res.status_code))
            -- success = explicit 2xx, OR no status reported but the executor didn't flag Success=false (some omit StatusCode)
            if (code and code >= 200 and code < 300) or (not code and not (res and res.Success == false)) then
                return true
            end
            if code == 429 then
                -- ★ DISCORD RATE-LIMIT: wait EXACTLY what Discord asks (Retry-After header in sec, or JSON body retry_after)
                local h = res.Headers or {}
                local wait = tonumber(h["Retry-After"] or h["retry-after"] or h["X-RateLimit-Reset-After"] or h["x-ratelimit-reset-after"])
                if not wait and res.Body then
                    local okb, jb = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if okb and jb then wait = tonumber(jb.retry_after) end
                end
                wait = wait or 1.5
                if wait < 0.5 then wait = 0.5 elseif wait > 10 then wait = 10 end
                task.wait(wait + 0.25)   -- +buffer so we land AFTER the window
            elseif code and code >= 400 and code < 500 then
                -- 4xx other than 429 (bad payload / deleted webhook) → retrying won't help → log + stop
                LOG(("[webhook] Discord rejected HTTP %d (not retrying): %s"):format(code, tostring(res and res.Body):sub(1, 140)))
                return false
            else
                task.wait(0.8)   -- 5xx / unknown → wait, retry
            end
        end
    until os.clock() >= deadline or attempt >= 50
    LOG(("[webhook] NOT delivered after %d tries / %.0fs — Discord unreachable or rate-limited too long (game-data may have gone through!)"):format(attempt, CONFIG.WebhookMaxWaitSec or 25))
    return false
end

