-- ============================================================================
-- WNLITE SIÊU-LITE — chỉ DECRYPT token "wnotifier.com-<hex>" (PAID key) cho cdev. XOR THUẦN: byte = bxor(c, K[pos]).
--   Bỏ pos_term, bỏ encrypt + FREE key (ClientSab ko encrypt, ko nhận token FREE), validity gọn (chỉ check dấu '-').
--   An toàn dựa: SECRET giấu (deob SENC) + Luraph virtualize hàm này. SENC_PAID PHẢI GIỐNG HỆT sab_scanner.
--   ⚠️ Đổi cipher (bỏ pos_term) → PHẢI deploy CẢ sab_scanner + ClientSab CÙNG LÚC (token bản cũ ko giải được bằng bản mới).
-- ============================================================================
local WNLite = (function()
    local schar, bxor = string.char, bit32.bxor
    local SENC_PAID = {0xb2,0x7b,0x5b,0x7e,0x93,0x63,0xa6,0x49,0xfe,0x3d,0x69,0xee,0x1a,0x74,0xaf,0x3e,0xb8,0x90,0x09,0x68,0xef,0x0f,0x34,0xd4,0x53,0x66,0xad,0x33,0x33,0x93,0xe6,0xdd,0x96,0x9a,0x3a,0xf2,0xf4,0xa4,0xe7,0xd7,0xd9,0xf0,0x25,0x9e,0xaa,0x18,0x01,0x2c}
    local K = {} for i = 1, #SENC_PAID do K[i] = bxor(SENC_PAID[i], (((i-1)*53)+0x59)%256) end   -- deob: giấu key (SENC ≠ key thật)
    local M = {} for i = 1, #K do M[i] = (K[i] * 73 + 41 + i * 17) % 256 end   -- ★ mask phụ tự chế (CÔNG THỨC GIỐNG HỆT sab_scanner)
    local KN, PREFIX, cache, cacheN = #K, "wnotifier.com-", {}, 0
    local function decrypt(token)
        if type(token) ~= "string" or token:sub(1, 14) ~= PREFIX then return nil end
        if #token > 4096 then return nil end                       -- ★ SEC: chặn token khổng lồ (relay độc nhồi → freeze/OOM)
        local c = cache[token]; if c ~= nil then return c end       -- cache CHỈ chứa UUID thành công (1 token nhiều pet → giải 1 lần)
        local hex, b, k = token:sub(15), {}, 0
        for i = 1, #hex, 2 do
            local v = tonumber(hex:sub(i, i + 1), 16); if not v then return nil end   -- ★ SEC: KHÔNG cache fail (chống nhồi token rác đầy cache → OOM)
            k = k + 1; b[k] = v
        end
        for i = k, 2, -1 do b[i] = bxor(b[i], b[i-1]) end   -- ③⁻¹ ngược feedback chain (chạy lùi)
        local out = {}
        for i = 1, k do out[i] = schar(bxor((b[i] - M[((i-1)%KN)+1]) % 256, K[((i-1)%KN)+1])) end   -- ②⁻¹ ngược mask + ①⁻¹ un-XOR
        local job = table.concat(out)
        if #job == 36 and job:byte(9) == 45 and job:byte(14) == 45 and job:byte(19) == 45 and job:byte(24) == 45 then
            if cacheN > 4096 then cache = {}; cacheN = 0 end        -- ★ SEC: cap cache (chống OOM session dài + relay nhồi UUID hợp lệ)
            cache[token] = job; cacheN = cacheN + 1; return job     -- UUID hợp lệ (đủ 36 + dấu '-' đúng chỗ) = giải đúng
        end
        return nil   -- ★ SEC: kết quả ko phải UUID → KHÔNG cache (chống nhồi)
    end
    return { decrypt = decrypt }
end)()
local WNCrypt = WNLite   -- alias (old UI/handlers calling WNCrypt.decrypt still work)

