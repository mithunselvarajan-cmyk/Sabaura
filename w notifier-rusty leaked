                    local ch = chOf(p.Name)
                    local list = ch and animalList(ch)
                    if type(list) == "table" then
                        for _, item in pairs(list) do
                            if type(item) == "table" and item.Index and want[item.Index] then
                                local w, wr = worthOf(item)
                                hits[#hits + 1] = { name = dispName(item.Index), tier = want[item.Index], mut = mutOf(item), worth = w or "?", raw = wr or 0 }
                            end
                        end
                    end
                end
            end
            if #hits > 0 then
                -- ★ nhóm theo tier → mỗi tier 1 field (emoji + count), sort $/s desc trong tier; màu embed = tier CAO NHẤT
                local byTier, topTier, topRank = {}, "LOW", 0
                for _, h in ipairs(hits) do
                    byTier[h.tier] = byTier[h.tier] or {}
                    table.insert(byTier[h.tier], h)
                    local r = (TIER_META[h.tier] or {}).rank or 0
                    if r > topRank then topRank, topTier = r, h.tier end
                end
                local order = { "OG", "PEAK", "HIGH", "MID", "LOW" }
                local sumParts, fields = {}, {}
                for _, tier in ipairs(order) do
                    local list = byTier[tier]
                    if list then
                        table.sort(list, function(a, b) return a.raw > b.raw end)   -- $/s cao → thấp trong tier
                        local m = TIER_META[tier] or {}
                        sumParts[#sumParts + 1] = ("%s %d %s"):format(m.emoji or "•", #list, tier)
                        local ln, cap = {}, 15   -- cap 15/tier (field value ≤ 1024 char)
                        for i = 1, math.min(#list, cap) do
                            local h = list[i]
                            ln[#ln + 1] = ("`%s`  %s%s"):format(h.worth, h.name, h.mut and ("  *(" .. h.mut .. ")*") or "")
                        end
                        if #list > cap then ln[#ln + 1] = ("*… +%d more*"):format(#list - cap) end
                        fields[#fields + 1] = { name = ("%s  %s  ·  %d"):format(m.emoji or "•", tier, #list), value = table.concat(ln, "\n"), inline = false }
                    end
                end
                local embed = {
                    title = "🎯 Joined a Server",
                    description = ("Found **%d** tracked pet%s   %s"):format(#hits, #hits == 1 and "" or "s", table.concat(sumParts, "  ·  ")),
                    color = (TIER_META[topTier] or {}).color or 0x2ECC71,
                    fields = fields,
                    footer = { text = ("%s  ·  Job %s"):format(LP.Name, tostring(game.JobId):sub(1, 8)) },
                }
                pcall(function() embed.timestamp = DateTime.now():ToIsoDate() end)
                pcall(postJson, url, { username = "W Notifier", embeds = { embed } })
                return   -- ★ báo 1 lần/phiên (teleport = re-exec = phiên mới → báo lại cho server mới)
            end
            task.wait(2)
        end
    end)
    task.spawn(function()
        while isCurrentGen() do                                                   -- ★ re-exec (gen mới) → loop cũ tự thoát (ko rescan chồng)
            task.wait(SD.RESCAN_SEC)
            if not isCurrentGen() then break end
            pcall(scanAllPlots)   -- lưới an toàn (plot mới stream)
            pcall(hookAllPlots)
            pcall(cachePrune)     -- xoá entry > 2h
            pcall(refreshDiscord) -- cập nhật discord_id (ESP publish / tự GET)
        end
    end)
end)
