--   Header X-API-Key = getgenv().Key (account key the script is currently using). All pcall, no print, drop the tick on 429.
-- ============================================================================
local function postGameRow(url, apiKey, data)
    if not httpRequest or not url or url == "" then return false end
    if not apiKey or apiKey == "" or not data or not data.name then return false end
    local ok, resp = pcall(httpRequest, {
        Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["X-API-Key"] = tostring(apiKey) },
        Body = HttpService:JSONEncode({
            name = data.name, money = data.money, time = data.time,
            status = data.status, mutation = data.mutation,
            traits = data.traits, animals = data.animals, category = data.category,
        }),
    })
    if not ok then return false end
    -- ★ trả TRUE chỉ khi HTTP 2xx (đọc StatusCode qua nhiều tên field của executor) → caller biết đã gửi xong để xoá khỏi hàng đợi
    local code = tonumber(resp and (resp.StatusCode or resp.Status or resp.status_code))
    return code ~= nil and code >= 200 and code < 300
end
