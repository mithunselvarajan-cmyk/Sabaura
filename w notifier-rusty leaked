	local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local B64R = {}; for i = 1, #B64 do B64R[string.sub(B64, i, i)] = i-1 end   -- ★ string.sub(B64,...) KHÔNG B64:sub — Luraph inline const → 'literal':sub() là LỖI cú pháp Luau
	local function enc(s) local o, i = {}, 1
		while i <= #s do local b1,b2,b3 = s:byte(i),s:byte(i+1),s:byte(i+2)
			local n = (b1 or 0)*65536+(b2 or 0)*256+(b3 or 0)
			local c1,c2,c3,c4 = math.floor(n/262144)%64, math.floor(n/4096)%64, math.floor(n/64)%64, n%64
			o[#o+1]=string.sub(B64, c1+1, c1+1); o[#o+1]=string.sub(B64, c2+1, c2+1)
			o[#o+1]=b2 and string.sub(B64, c3+1, c3+1) or "="; o[#o+1]=b3 and string.sub(B64, c4+1, c4+1) or "="; i=i+3 end
		return table.concat(o) end
	local function dec(d) d=d:gsub("[^%w%+%/%=]",""); local o,i={},1
		while i <= #d do local a,b=B64R[d:sub(i,i)] or 0,B64R[d:sub(i+1,i+1)] or 0
			local c4,d4=d:sub(i+2,i+2),d:sub(i+3,i+3); local c,dd=B64R[c4] or 0,B64R[d4] or 0
			local n=a*262144+b*4096+c*64+dd; o[#o+1]=string.char(math.floor(n/65536)%256)
			if c4~="=" then o[#o+1]=string.char(math.floor(n/256)%256) end
			if d4~="=" then o[#o+1]=string.char(n%256) end; i=i+4 end
		return table.concat(o) end
