local function applyIdentity(char)
    local masked = CONFIG.StreamSafe
    local MASK = CONFIG.StreamMask or "Hidden"
    pcall(function() LocalPlayer.DisplayName = masked and MASK or REAL_DISPLAY end)
    if char then
