-- ★ MASK BASE SIGN: base sign shows "<real name>'s Base" → leaks name on stream. Mask that text label (client-only display,
--   no logic change — findMyPlot runs with REAL_NAME BEFORE masking). Save original text to revert; hook re-render to re-mask.
local _myBase = nil
local _baseSignOrig, _baseSignHooked = {}, {}
local function maskBaseSign()
    local plot = _myBase
    if not (plot and plot.Parent) then return end
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return end
    local MASKTXT = (CONFIG.StreamMask or "Hidden") .. "'s Base"
    for _, d in ipairs(sign:GetDescendants()) do
        if d:IsA("TextLabel") then
            local t = tostring(d.Text)
            local isOwner = _baseSignOrig[d] ~= nil or t:match("'s Base$")
                or (REAL_NAME ~= "" and t:find(REAL_NAME, 1, true)) or (REAL_DISPLAY ~= "" and t:find(REAL_DISPLAY, 1, true))
            if isOwner then
                if _baseSignOrig[d] == nil and t ~= MASKTXT then _baseSignOrig[d] = t end   -- save real name once
                local want = CONFIG.StreamSafe and MASKTXT or (_baseSignOrig[d] or t)
                if d.Text ~= want then pcall(function() d.Text = want end) end
                if not _baseSignHooked[d] then   -- game re-render resets the real name when StreamSafe ON → re-mask
                    _baseSignHooked[d] = true
                    d:GetPropertyChangedSignal("Text"):Connect(function()
                        if isCurrentGen() and CONFIG.StreamSafe and d.Text ~= MASKTXT then pcall(function() d.Text = MASKTXT end) end
                    end)
                end
            end
        end
    end
end
local function setStreamIdentity()
    pcall(applyIdentity, LocalPlayer.Character)
    pcall(maskBaseSign)   -- ★ mask/revert the base sign per StreamSafe (if the base was found)
    if not _identityHooked then
        _identityHooked = true
        LocalPlayer.CharacterAdded:Connect(function(c)
            if not isCurrentGen() then return end
            task.wait(0.3); pcall(applyIdentity, c)   -- respawn resets overhead → re-mask per current StreamSafe
        end)
    end
end

