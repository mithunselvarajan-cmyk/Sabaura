	local TIERNAME_SET, BRAINROTS, BR_TIER = {}, {}, {}
	for _, T in ipairs(TIER_ORDER) do
		for _, nm in ipairs(TIER_NAMES[T] or {}) do
			local key = tostring(nm):lower()
			if not TIERNAME_SET[key] then
				TIERNAME_SET[key] = T
				BRAINROTS[#BRAINROTS + 1] = nm
				BR_TIER[nm] = T
			end
		end
	end
	-- ★ MỘT WHITELIST DUY NHẤT (gộp lại theo yêu cầu): điều khiển CẢ lọc logs LẪN auto-join. {name={on,num,mut}}.
	Config.WNWhitelist = (type(Config.WNWhitelist) == "table") and Config.WNWhitelist or {}
	-- migrate 2 list thời-tách (WNWLLog/WNWLAuto) → gộp vào WNWhitelist (union: on nếu on ở 1 trong 2; num/mut ưu tiên cái đã đặt)
	do
		local function mergeIn(src)
			if type(src) ~= "table" then return end
			for nm, d in pairs(src) do
				if type(d) == "table" and (d.on or (d.num and d.num ~= "")) then
					local cur = Config.WNWhitelist[nm]
					if not cur then Config.WNWhitelist[nm] = { on = d.on == true, num = tostring(d.num or ""), mut = d.mut or "Any" }
					else
						cur.on = cur.on or (d.on == true)
						if (cur.num or "") == "" then cur.num = tostring(d.num or "") end
						if (cur.mut or "Any") == "Any" then cur.mut = d.mut or "Any" end
					end
				end
			end
		end
		mergeIn(Config.WNWLAuto); mergeIn(Config.WNWLLog)
		Config.WNWLLog = nil; Config.WNWLAuto = nil   -- ★ bỏ 2 list tách
	end
	-- prune tên-lạ (ngoài TierNames) → đếm/export/khớp sạch
